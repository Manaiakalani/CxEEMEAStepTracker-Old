*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Playwright test artifacts
test-results/
playwright-report/

# Design audit screenshots (regenerated by tests/design-audit.spec.ts, ~60 MB)
design-review-screenshots/

# Admin SPA (Vite)
admin/.vite/
admin/node_modules/
# admin/dist/ IS committed so the parent static site can serve it (rebuild via 'cd admin && npm install && npm run build')

# TypeScript incremental build info
admin/tsconfig.*.tsbuildinfo
